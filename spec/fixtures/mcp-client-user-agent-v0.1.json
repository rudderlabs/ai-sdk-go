{
  "fixture_version": 1,
  "description": "Built-in MCP client fallback on HTTP transports. It runs only when initialize, per-call metadata, connection or session state, resolveClient, remembered clients and the app's clientInfoFallback give no client name or version. Take the request's User-Agent header; without one (or blank after trimming), the fallback does nothing (`expected: null`). Otherwise take its first product token: trim leading and trailing spaces and tabs, cut at the first space or tab, split at the first `/` into product and version. Compare the product, ASCII-lowercased, with the keys of `products`; a match sets `client_name` to the client's own initialize clientInfo name, so both paths group together. Any other product gives `client_name` `other` and no version. A matched client keeps the version only when it matches `version_pattern` (no flags); otherwise the version is omitted. The raw header is never sent.",
  "version_pattern": "^[0-9][0-9A-Za-z.+-]{0,31}$",
  "products": {
    "claude-code": "claude-code",
    "claude": "Anthropic/ClaudeAI",
    "cursor": "Cursor",
    "openai-mcp": "openai-mcp",
    "codex_cli_rs": "codex-mcp-client",
    "opencode": "opencode"
  },
  "cases": [
    { "name": "claude_code_cli", "user_agent": "claude-code/2.1.322 (cli)", "expected": { "client_name": "claude-code", "client_version": "2.1.322" } },
    { "name": "claude_code_sdk_surface", "user_agent": "claude-code/2.1.0 (sdk-ts)", "expected": { "client_name": "claude-code", "client_version": "2.1.0" } },
    { "name": "claude_code_build_version", "user_agent": "claude-code/2.1.324-ccs.sha39b9eed62769 (cli)", "expected": { "client_name": "claude-code", "client_version": "2.1.324-ccs.sha39b9eed62769" } },
    { "name": "claude_connector", "user_agent": "Claude/1.0", "expected": { "client_name": "Anthropic/ClaudeAI", "client_version": "1.0" } },
    { "name": "cursor_any_case", "user_agent": "CURSOR/1.7.4 node", "expected": { "client_name": "Cursor", "client_version": "1.7.4" } },
    { "name": "chatgpt_connector", "user_agent": "openai-mcp/1.0.0", "expected": { "client_name": "openai-mcp", "client_version": "1.0.0" } },
    { "name": "codex_cli", "user_agent": "codex_cli_rs/0.167.0 (Mac OS 26.1.0; arm64) iTerm.app/3.6.6", "expected": { "client_name": "codex-mcp-client", "client_version": "0.167.0" } },
    { "name": "opencode", "user_agent": "opencode/2.2.5", "expected": { "client_name": "opencode", "client_version": "2.2.5" } },
    { "name": "no_version", "user_agent": "claude-code", "expected": { "client_name": "claude-code" } },
    { "name": "empty_version", "user_agent": "claude-code/ (cli)", "expected": { "client_name": "claude-code" } },
    { "name": "version_not_a_version", "user_agent": "claude-code/latest", "expected": { "client_name": "claude-code" } },
    { "name": "version_with_markup", "user_agent": "claude-code/1.0<script>", "expected": { "client_name": "claude-code" } },
    { "name": "version_too_long", "user_agent": "claude-code/1.000000000000000000000000000000000", "expected": { "client_name": "claude-code" } },
    { "name": "version_with_slash", "user_agent": "cursor/1.2/3", "expected": { "client_name": "Cursor" } },
    { "name": "leading_whitespace", "user_agent": "  \tclaude-code/2.1.0", "expected": { "client_name": "claude-code", "client_version": "2.1.0" } },
    { "name": "tab_separator", "user_agent": "opencode/1.19.1\tbun/1.3", "expected": { "client_name": "opencode", "client_version": "1.19.1" } },
    { "name": "known_name_later_in_header", "user_agent": "Mozilla/5.0 claude-code/2.1.0", "expected": { "client_name": "other" } },
    { "name": "generic_sdk", "user_agent": "mcp/0.1.0", "expected": { "client_name": "other" } },
    { "name": "http_library", "user_agent": "python-httpx/0.28.1", "expected": { "client_name": "other" } },
    { "name": "rust_mcp_library", "user_agent": "rmcp/3.2.0", "expected": { "client_name": "other" } },
    { "name": "browser", "user_agent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7)", "expected": { "client_name": "other" } },
    { "name": "prefix_is_not_a_match", "user_agent": "claude-codex/1.0", "expected": { "client_name": "other" } },
    { "name": "sensitive_unknown_product", "user_agent": "jane.doe@example.com/1.0", "expected": { "client_name": "other" } },
    { "name": "slash_only", "user_agent": "/1.0", "expected": { "client_name": "other" } },
    { "name": "blank", "user_agent": "   ", "expected": null },
    { "name": "absent", "user_agent": null, "expected": null }
  ]
}
