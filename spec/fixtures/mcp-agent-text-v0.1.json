{
  "fixture_version": 1,
  "description": "Agent-written text on MCP events, sent only when content capture allows it: `call_reason` (from `request_context`), `capability_detail` (`request_capability` `detail`) and `feedback_text` (`submit_feedback` `feedback`). Trim surrounding whitespace; mask with the opt-in text masking (built-in rules of `redaction-v0.1.json`, then the app's redact hook; with redaction off, neither runs); withhold the field when masking fails or the text still matches a built-in rule, with redaction off too: turning redaction off disables masking, not this check. Then cut to the field's `max_chars` code points, keeping any space the cut ends on, and withhold the field when the cut text matches a built-in rule (the cut removed the text that kept it from matching). `redaction` is `on` (default masking, no hook) or `off`. `expected: null` means the field is left out.",
  "max_chars": {
    "call_reason": 200,
    "capability_detail": 200,
    "feedback_text": 2000
  },
  "cases": [
    {"name": "call_reason_masked", "field": "call_reason", "redaction": "on", "text": "mail ann@example.com now", "expected": "mail [email] now"},
    {"name": "call_reason_trimmed", "field": "call_reason", "redaction": "on", "text": "  look up the order \n", "expected": "look up the order"},
    {"name": "call_reason_redaction_off_plain", "field": "call_reason", "redaction": "off", "text": "look up the order", "expected": "look up the order"},
    {"name": "call_reason_redaction_off_email_withheld", "field": "call_reason", "redaction": "off", "text": "mail ann@example.com now", "expected": null},
    {"name": "call_reason_cut_exposes_a_pattern", "field": "call_reason", "redaction": "on", "text": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx 415-555-0100-9", "expected": null},
    {"name": "call_reason_cut_keeps_a_trailing_space", "field": "call_reason", "redaction": "on", "text": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx y", "expected": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx "},
    {"name": "call_reason_blank", "field": "call_reason", "redaction": "on", "text": " \t ", "expected": null},
    {"name": "capability_detail_masked", "field": "capability_detail", "redaction": "on", "text": "export rows for jane.doe@acme.com", "expected": "export rows for [email]"},
    {"name": "capability_detail_redaction_off_email_withheld", "field": "capability_detail", "redaction": "off", "text": "export rows for jane.doe@acme.com", "expected": null},
    {"name": "capability_detail_cut_exposes_a_pattern", "field": "capability_detail", "redaction": "on", "text": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx 123-45-6789-0", "expected": null},
    {"name": "feedback_text_masked", "field": "feedback_text", "redaction": "on", "text": "call me at +1 415 555 0100", "expected": "call me at [phone]"},
    {"name": "feedback_text_redaction_off_plain", "field": "feedback_text", "redaction": "off", "text": "the export was slow", "expected": "the export was slow"},
    {"name": "feedback_text_redaction_off_email_withheld", "field": "feedback_text", "redaction": "off", "text": "write to ann@example.com", "expected": null},
    {"name": "feedback_text_cut_exposes_a_pattern", "field": "feedback_text", "redaction": "on", "text": " 415-555-0100-9", "expected": null}
  ]
}
