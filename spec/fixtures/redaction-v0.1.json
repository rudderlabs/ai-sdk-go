  "rules": [
    {
      "name": "pem_private_key",
      "pattern": "-----BEGIN[A-Z0-9 ]*PRIVATE KEY-----(?:[^-]|-(?!----))*(?:-----END[A-Z0-9 ]*PRIVATE KEY-----)?",
      "token": "secret"
    },
    {
      "name": "bearer",
      "pattern": "(?<![A-Za-z0-9_-])[Bb]earer[ \\t]+[A-Za-z0-9._~+/-]{16,}=*",
      "token": "secret"
    },
    {
      "name": "jwt",
      "pattern": "(?<![A-Za-z0-9_-])eyJ[A-Za-z0-9_-]+\\.eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+",
      "token": "secret"
    },
    {
      "name": "openai_anthropic_key",
      "pattern": "(?<![A-Za-z0-9_-])sk-[A-Za-z0-9_-]{16,}",
      "token": "secret"
    },
    {
      "name": "stripe_key",
      "pattern": "(?<![A-Za-z0-9_-])(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{10,}",
      "token": "secret"
    },
    {
      "name": "google_api_key",
      "pattern": "(?<![A-Za-z0-9_-])AIza[0-9A-Za-z_-]{35}(?![0-9A-Za-z_-])",
      "token": "secret"
    },
    {
      "name": "google_oauth_token",
      "pattern": "(?<![A-Za-z0-9_-])ya29\\.[0-9A-Za-z_-]{20,}",
      "token": "secret"
    },
    {
      "name": "slack_token",
      "pattern": "(?<![A-Za-z0-9_-])xox[abposr]-[A-Za-z0-9-]{10,}",
      "token": "secret"
    },
    {
      "name": "github_token",
      "pattern": "(?<![A-Za-z0-9_-])gh[pousr]_[A-Za-z0-9]{20,}",
      "token": "secret"
    },
    {
      "name": "aws_access_key",
      "pattern": "(?<![A-Za-z0-9])(?:AKIA|ASIA)[A-Z0-9]{16}(?![A-Za-z0-9])",
      "token": "secret"
    },
    {
      "name": "url_password",
      "pattern": "((?<![A-Za-z0-9+.-])[A-Za-z][A-Za-z0-9+.-]*://[^ \\t\\r\\n:/@]*:)[^ \\t\\r\\n/@]+(?=@)",
      "token": "secret",
      "keep_group": 1
    },
    {
      "name": "key_value_secret",
      "pattern": "((?<![A-Za-z0-9_-])(?:[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Aa][Cc][Cc][Ee][Ss][Ss][_-]?[Tt][Oo][Kk][Ee][Nn]|[Aa][Uu][Tt][Hh][_-]?[Tt][Oo][Kk][Ee][Nn]|[Cc][Ll][Ii][Ee][Nn][Tt][_-]?[Ss][Ee][Cc][Rr][Ee][Tt]|[Ss][Ee][Cc][Rr][Ee][Tt][_-]?[Kk][Ee][Yy]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd]|[Pp][Ww][Dd])[\"']?[ \\t]*[:=][ \\t]*[\"']?)[^ \\t\\r\\n\"'&,;]{4,}",
      "token": "secret",
      "keep_group": 1
    },
    {
      "name": "email",
      "pattern": "(?<![A-Za-z0-9._%+\\u00C0-\\uD7FF-])[A-Za-z0-9._%+\\u00C0-\\uD7FF-]+@[A-Za-z0-9\\u00C0-\\uD7FF-]+(?:\\.[A-Za-z0-9\\u00C0-\\uD7FF-]+)*\\.[A-Za-z\\u00C0-\\uD7FF]{2,}",
      "token": "email"
    },
    {
      "name": "ipv4",
      "pattern": "(?<![A-Za-z0-9.])(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?![0-9]|\\.[0-9])",
      "token": "ip"
    },
    {
      "name": "ipv6",
      "pattern": "(?<![A-Za-z0-9:.])(?:[0-9A-Fa-f]{0,4}:){2,7}[0-9A-Fa-f]{0,4}(?![A-Za-z0-9:])",
      "token": "ip",
      "check": "ipv6"
    },
    {
      "name": "iban",
      "pattern": "(?<![A-Za-z0-9])[A-Z]{2}[0-9]{2}(?: ?[A-Z0-9]{4}){2,7}(?: ?[A-Z0-9]{1,4})?(?![A-Za-z0-9])",
      "token": "iban",
      "check": "iban"
    },
    {
      "name": "us_ssn",
      "pattern": "(?<![0-9-])[0-9]{3}-[0-9]{2}-[0-9]{4}(?![0-9-])",
      "token": "ssn",
      "check": "ssn"
    },
    {
      "name": "card",
      "pattern": "(?<![0-9])[0-9](?:[ -]?[0-9]){12,18}(?![0-9])",
      "token": "card",
      "check": "luhn"
    },
    {
      "name": "phone",
      "pattern": "(?<![A-Za-z0-9+])(?<![0-9][ .-])(?:\\+[0-9]{1,3}(?:[ .-]?(?:\\([0-9]{1,4}\\)|[0-9]{1,4})){2,6}|(?:\\([0-9]{2,4}\\)[ .-]?|[0-9]{2,4}[ .-])[0-9]{3,4}[ .-][0-9]{3,4}|[0-9]{4,5}[ .-][0-9]{5,6})(?![0-9A-Za-z]|[ .-][0-9])",
      "token": "phone",
      "check": "phone"
    }
  ]
}
