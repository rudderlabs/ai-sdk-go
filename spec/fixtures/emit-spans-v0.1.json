    {
      "name": "portable-containers",
      "config": {
        "emit_spans": true,
        "capture_content": true
      },
      "steps": [
        {
          "kind": "span",
          "name": "retrieval",
          "operation": "retrieval",
          "advance_ms": 10,
          "attributes": {
            "input.value": {
              "$container": "map",
              "entries": [
                [
                  1,
                  "a@example.com"
                ],
                [
                  {
                    "$container": "bigint",
                    "value": "2"
                  },
                  "two"
                ],
                [
                  true,
                  {
                    "$container": "set",
                    "values": [
                      "keep",
                      {
                        "$container": "bytes",
                        "values": [
                          1,
                          2
                        ]
                      }
                    ]
                  }
                ],
                [
                  {
                    "key": "object"
                  },
                  "drop"
                ],
                [
                  {
                    "$container": "symbol"
                  },
                  "drop"
                ],
                [
                  "cycle",
                  {
                    "$container": "cycle",
                    "value": {
                      "text": "keep"
                    },
                    "self_key": "self"
                  }
                ],
                [
                  "class",
                  {
                    "$container": "class",
                    "fields": {
                      "text": "a@example.com",
                      "bytes": {
                        "$container": "bytes",
                        "values": [
                          3
                        ]
                      }
                    }
                  }
                ],
                [
                  "numeric",
                  {
                    "$container": "map",
                    "entries": [
                      [
                        1,
                        7
                      ],
                      [
                        2,
                        8
                      ]
                    ]
                  }
                ]
              ]
            }
          }
        }
      ],
      "clock": {
        "start_ms": 1760000000000
      },
      "ids": {
        "trace_ids": [
          "1234567890abcdef1234567890abcdef"
        ],
        "span_ids": [
          "0000000000000001"
        ]
      },
      "expected_spans": [
        {
          "span_name": "retrieval",
          "trace_id": "1234567890abcdef1234567890abcdef",
          "span_id": "0000000000000001",
          "parent_span_id": null,
          "duration_ms": 10,
          "status_code": "ok",
          "attributes": {
            "gen_ai.operation.name": "retrieval",
            "rudderstack.span_source": "manual",
            "input.value": {
              "1": "[email]",
              "2": "two",
              "true": [
                "keep"
              ],
              "cycle": {
                "text": "keep"
              },
              "class": {
                "text": "[email]"
              },
              "numeric": {
                "1": 7,
                "2": 8
              }
            }
          }
        }
      ],
      "expected_call_span_ids": []
    }
