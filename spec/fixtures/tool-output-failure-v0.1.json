{
  "fixture_version": 1,
  "spec_version": "0.4.0",
  "description": "Node and Python function-tool output failure convention. Inspect only a plain object or JSON object string with top-level boolean successful false. Framework failures retain precedence and calls count once.",
  "cases": [
    {
      "name": "object successful false",
      "output": {
        "successful": false,
        "error": "backend down"
      },
      "expected": {
        "error": true,
        "error_type": "api_error"
      }
    },
    {
      "name": "JSON string successful false",
      "output": " \n {\"successful\": false, \"error\": \"backend down\"} ",
      "expected": {
        "error": true,
        "error_type": "api_error"
      }
    },
    {
      "name": "double-encoded JSON string successful false",
      "output": "\"{\\\"successful\\\":false}\"",
      "expected": {
        "error": false
      }
    },
    {
      "name": "successful true",
      "output": {
        "successful": true
      },
      "expected": {
        "error": false
      }
    },
    {
      "name": "successful string false",
      "output": {
        "successful": "false"
      },
      "expected": {
        "error": false
      }
    },
    {
      "name": "missing key",
      "output": {
        "data": "ok"
      },
      "expected": {
        "error": false
      }
    },
    {
      "name": "nested successful false",
      "output": {
        "data": {
          "successful": false,
          "error": "backend down"
        }
      },
      "expected": {
        "error": false
      }
    },
    {
      "name": "non-JSON string",
      "output": "backend down",
      "expected": {
        "error": false
      }
    },
    {
      "name": "array of failures",
      "output": [
        {
          "successful": false
        }
      ],
      "expected": {
        "error": false
      }
    },
    {
      "name": "JSON array of failures",
      "output": "[{\"successful\":false}]",
      "expected": {
        "error": false
      }
    },
    {
      "name": "JSON string successful true",
      "output": "{\"successful\":true}",
      "expected": {
        "error": false
      }
    },
    {
      "name": "JSON string successful string false",
      "output": "{\"successful\":\"false\"}",
      "expected": {
        "error": false
      }
    },
    {
      "name": "JSON string missing key",
      "output": "{\"data\":\"ok\"}",
      "expected": {
        "error": false
      }
    },
    {
      "name": "JSON string nested successful false",
      "output": "{\"results\":[{\"successful\":false,\"error\":\"backend down\"}]}",
      "expected": {
        "error": false
      }
    },
    {
      "name": "malformed JSON",
      "output": "{\"successful\":false",
      "expected": {
        "error": false
      }
    },
    {
      "name": "null",
      "output": null,
      "expected": {
        "error": false
      }
    },
    {
      "name": "boolean false",
      "output": false,
      "expected": {
        "error": false
      }
    },
    {
      "name": "framework failure with successful false",
      "framework_failure": true,
      "output": {
        "successful": false,
        "error": "backend down"
      },
      "expected": {
        "error": true
      }
    },
    {
      "name": "framework failure with JSON string successful false",
      "framework_failure": true,
      "output": "{\"successful\":false,\"error\":\"backend down\"}",
      "expected": {
        "error": true
      }
    }
  ]
}
