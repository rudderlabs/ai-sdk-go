{
  "fixture_version": 1,
  "description": "Which segment counts a call or tool recorded while a pause or the final end delivers events. Usage recorded during pause delivery belongs to the paused segment, counted once, with its own call and tool events; the final end refuses it, as any write after end.",
  "cases": [
    {
      "name": "wrapper call recorded during paused call delivery",
      "description": "A held span call event is delivered by pause; the app's transport callback records another call. The paused segment counts both.",
      "config": {
        "emit_llm_calls": true
      },
      "steps": [
        {
          "op": "record_call",
          "source": "span",
          "provider": "openai",
          "model": "gpt-4.1",
          "input_tokens": 10,
          "started_ms": 100,
          "ended_ms": 110
        },
        {
          "op": "on_event",
          "event": "ai_llm_response_received",
          "steps": [
            {
              "op": "record_call",
              "provider": "openai",
              "model": "gpt-4.1",
              "input_tokens": 20,
              "started_ms": 300,
              "ended_ms": 310
            }
          ]
        },
        {
          "op": "pause"
        },
        {
          "op": "resume"
        },
        {
          "op": "end"
        }
      ],
      "expected": {
        "segments": [
          {
            "response_status": "paused",
            "llm_call_count": 2,
            "total_input_tokens": 30
          },
          {
            "llm_call_count": 0
          }
        ],
        "call_events": [
          10,
          20
        ],
        "tool_events": []
      }
    },
    {
